+def test_init_schema_is_idempotent_and_records_version(tmp_path: Path) -> None:
+    db_path = tmp_path / "state.db"
+    store = PageStateStore(db_path)
+    store.init_schema()
+    store.upsert_ocr_page("Quick", 19, "rev-1", "raw", "glm-4.5v")
+
+    # Re-running migration in-process must be a no-op.
+    store.init_schema()
+    assert store.schema_version() == PAGE_STATE_SCHEMA_VERSION
+    assert store.get_page("Quick", 19).raw_text == "raw"
+
+
+def test_init_schema_idempotent_across_reopens_preserves_rows(
+    tmp_path: Path,
+) -> None:
+    db_path = tmp_path / "state.db"
+    store = PageStateStore(db_path)
+    store.init_schema()
+    store.upsert_ocr_page("Quick", 19, "rev-1", "raw", "glm-4.5v")
+    store.upsert_ocr_page("Quick", 20, "rev-1", "raw-20", "glm-4.5v")
+
+    # A fresh store opening the existing database migrates safely.
+    reopened = PageStateStore(db_path)
+    reopened.init_schema()
+    reopened.init_schema()
+
+    assert reopened.schema_version() == PAGE_STATE_SCHEMA_VERSION
+    assert reopened.get_page("Quick", 19).raw_text == "raw"
+    assert reopened.get_page("Quick", 20).raw_text == "raw-20"
