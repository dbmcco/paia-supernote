+def _seed_revision(tmp_path: Path, notebook: str = "Quick") -> None:
+    ledger = CloudChangeLedger(tmp_path / "state.db")
+    ledger.init_schema()
+    ledger.apply_snapshot(
+        NotebookSnapshot(
+            notebook=notebook,
